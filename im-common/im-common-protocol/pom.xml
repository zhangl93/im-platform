<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.im.platform</groupId>
    <artifactId>im-common</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>im-common-protocol</artifactId>
  <packaging>jar</packaging>

  <name>im-common-protocol</name>
  <description>
    公共 proto 定义(Empty/PageRequest 等跨服务复用消息 + gateway 的 GatewayRequest/GatewayResponse
    信封)、gateway 密钥协商与加解密(X25519 + AES-GCM,crypto 包,纯 JDK 17 原生 API 实现,
    不依赖 Bouncy Castle)、gRPC 统一异常拦截器 BizExceptionInterceptor。
  </description>

  <dependencies>
    <dependency>
      <groupId>com.im.platform</groupId>
      <artifactId>im-common-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- 把 .proto 源文件也打进本模块的 jar 包根目录:下游模块(session/biz-api/...)
           声明依赖后,protobuf-maven-plugin 会自动扫描依赖 jar 里的 .proto 文件用于解析 import,
           不需要每个模块各自维护一份 common.proto 副本。 -->
      <resource>
        <directory>${project.basedir}/src/main/proto</directory>
      </resource>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
