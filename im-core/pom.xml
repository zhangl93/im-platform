<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.im.platform</groupId>
    <artifactId>im-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>im-core</artifactId>
  <packaging>jar</packaging>

  <name>im-core</name>
  <description>
    IM 平台核心域,单体部署:鉴权/连接状态(session)、用户群组 DDD(biz)、
    消息读写(msg)、多端增量同步(sync)、在线状态(status)、发号(idgen,纯内部组件)、
    文件上传凭证(dfs)。协议语义 -&gt; 内部调用的翻译由 im-gateway 的 MethodRegistry 直接承担。
    内容审核/翻译/AI 分析不再内置,通过回调钩子交给业务系统。
  </description>

  <!-- flyway-maven-plugin 单独读这几个属性,不复用 application.yml 里的 spring.datasource——
       CI 里没有 Spring 上下文,只想拿 flyway-maven-plugin 单独跑 migrate/validate,
       不需要(也不应该)为了验证几个 .sql 文件把整个 Spring Boot 应用跑起来。
       本地默认值跟 application.yml 保持一致,CI 用 -Dflyway.url=... 等覆盖即可。 -->
  <properties>
    <flyway.url>jdbc:mysql://127.0.0.1:3306/im_core?useUnicode=true&amp;characterEncoding=UTF-8&amp;useSSL=false&amp;serverTimezone=Asia/Shanghai&amp;allowPublicKeyRetrieval=true</flyway.url>
    <flyway.user>root</flyway.user>
    <flyway.password>root</flyway.password>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.im.platform</groupId>
      <artifactId>im-common-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.im.platform</groupId>
      <artifactId>im-common-protocol</artifactId>
    </dependency>
    <dependency>
      <groupId>com.im.platform</groupId>
      <artifactId>im-core-api</artifactId>
    </dependency>

    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-services</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
    </dependency>

    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- 版本由 spring-boot-dependencies(im-bom 里 import 的)统一管理,不用自己锁版本。
         flyway-mysql 是必须的:Flyway 8+ 把 MySQL 支持拆到了单独模块,只有 flyway-core 认不出 MySQL 8。 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>

    <dependency>
      <groupId>io.minio</groupId>
      <artifactId>minio</artifactId>
      <version>8.5.11</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- 消息存储可选后端(message.storage.type=mongodb),见 com.im.platform.msg.store.mongo。
         Spring Boot 自动配置在 mysql 模式下也会创建 MongoClient bean,但同步驱动的连接是懒建立的
         (第一次真正发请求才连),classpath 上有这个依赖不代表启动时就要求 MongoDB 在跑。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- CI 用 `mvn -pl im-core flyway:migrate` 单独校验迁移脚本能不能从空库一路跑通
           (捕获语法错误、顺序错误、校验和不一致),不用启动完整 Spring Boot 应用(那还得连
           Redis/MongoDB/gRPC/web 端口,验证几个 .sql 文件不需要这些)。版本跟随
           flyway-core(见上面依赖注释,由 spring-boot-dependencies BOM 统一管理),
           这里手动锁同一个版本号,因为 flyway-maven-plugin 不受那个 BOM 管理。 -->
      <plugin>
        <groupId>org.flywaydb</groupId>
        <artifactId>flyway-maven-plugin</artifactId>
        <version>9.22.3</version>
        <configuration>
          <url>${flyway.url}</url>
          <user>${flyway.user}</user>
          <password>${flyway.password}</password>
          <locations>
            <location>classpath:db/migration</location>
          </locations>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <version>9.22.3</version>
          </dependency>
          <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.3.0</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!-- ACK 机制在 im-core 这一侧的落地点是 AckService(记录投递确认 + 离线补偿去重判断依据),
               只框定这一个类,不是整个 msg 包(msg 包里其它类是消息落库/推送,属于其它验收标准范围)。 -->
          <execution>
            <id>jacoco-check-core-modules</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <includes>
                <include>com/im/platform/msg/service/AckService.class</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.70</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
