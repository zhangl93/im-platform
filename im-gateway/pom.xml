<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.im.platform</groupId>
    <artifactId>im-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>im-gateway</artifactId>
  <packaging>jar</packaging>

  <name>im-gateway</name>
  <description>
    瘦网关:只做协议解包(自研二进制协议)与到 session 层的转发,不含业务逻辑、不套 DDD。
    对尾延迟敏感,依赖 Netty + ZGC 而非重框架。
  </description>

  <dependencies>
    <dependency>
      <groupId>com.im.platform</groupId>
      <artifactId>im-common-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.im.platform</groupId>
      <artifactId>im-common-protocol</artifactId>
    </dependency>
    <dependency>
      <groupId>com.im.platform</groupId>
      <artifactId>im-core-api</artifactId>
    </dependency>

    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-all</artifactId>
    </dependency>

    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- 没有内嵌 Web 容器,Actuator 端点就没有 HTTP 入口暴露不出来;
         而且纯 grpc-java(默认 executor 是 daemon 线程)+ 无 web 容器的进程,
         main() 一返回 JVM 就直接退出。这个依赖同时解决这两个问题。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>
    <!-- 跨网关实例消息推送路由:PushRouter 订阅 im-core 发布的 Redis Pub/Sub 频道。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- /actuator/prometheus 端点要有具体的 registry 实现才会真正暴露,
         光配 management.endpoints.web.exposure.include=prometheus 不够。 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 只在 test scope 依赖 im-core,不是为了编译期用它的类(集成测试用 ProcessBuilder 拉起
         真实的 im-core.jar 子进程,不在同一个 JVM 里跑),是为了让 Maven reactor 按依赖图
         把 im-core 排在 im-gateway 前面构建——不然 mvn verify 时 GatewayCrashRecoveryIT
         要用的 im-core jar 可能还没打出来。 -->
    <dependency>
      <groupId>com.im.platform</groupId>
      <artifactId>im-core</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <!-- 验收标准要求的是"编解码器/路由/ACK 机制"覆盖率≥70%,不是整个网关模块——
               网关里 GatewayApplication/NettyGatewayServer/CoreGrpcClients 这些纯装配类
               没有分支逻辑,测了也没意义,只框定 codec 包和 router 包(路由分发 + ACK 转发都在这)。 -->
          <execution>
            <id>jacoco-check-core-modules</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <includes>
                <include>com/im/platform/gateway/codec/**</include>
                <include>com/im/platform/gateway/router/**</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.70</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
